<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- ✅ Permissions -->
    <uses-permission android:name="android.permission.CALL_PHONE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- ✅ Add storage permissions for PDF saving -->
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" />
    <uses-permission
        android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="29" />

    <!-- ✅ Fix for CALL_PHONE permission implying telephony hardware -->
    <uses-feature
        android:name="android.hardware.telephony"
        android:required="false" />

    <application
        android:allowBackup="true"
        android:icon="@mipmap/iprepare_logo"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.iPrepare">

        <!-- 🟢 Splash Screen (launches first) -->
        <activity
            android:name=".SplashActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- 🟢 Get Started Screen -->
        <activity
            android:name=".GetStartedActivity"
            android:exported="true" />

        <!-- 🟠 Authentication -->
        <activity
            android:name=".LoginActivity"
            android:exported="true" />
        <activity
            android:name=".RegisterActivity"
            android:exported="true" />
        <activity
            android:name=".ForgotPasswordActivity"
            android:exported="true" />

        <!-- 🟣 Core App Screens -->
        <activity
            android:name=".MainActivity"
            android:exported="true" />
        <activity
            android:name=".OpenModulesActivity"
            android:exported="false" />
        <activity
            android:name=".TopicsActivity"
            android:exported="false" />
        <activity
            android:name=".ModuleContentActivity"
            android:exported="false" />

        <!-- ✅ PDF Viewer with download feature -->
        <activity
            android:name=".PDFViewerActivity"
            android:exported="false"
            android:theme="@style/Theme.MaterialComponents.DayNight.NoActionBar" />

        <!-- 🆕 Prepare Details -->
        <activity
            android:name=".PrepareDetailActivity"
            android:exported="true" />

        <activity
            android:name=".StartQuizActivity"
            android:exported="true" />
        <activity
            android:name=".QuizActivity"
            android:exported="false" />
        <activity
            android:name=".QuizResultActivity"
            android:exported="true" />

        <!-- 🧩 Optional sections -->
        <activity
            android:name=".ProfileActivity"
            android:exported="true" />
        <activity
            android:name=".EmergencyActivity"
            android:exported="true" />
        <activity
            android:name=".AdminUploadActivity"
            android:exported="true" />
        <activity
            android:name=".UpdatesActivity"
            android:exported="true" />
        <activity
            android:name=".AdminPanelActivity"
            android:exported="true" />

    </application>
</manifest>
