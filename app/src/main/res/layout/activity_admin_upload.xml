<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/colorBackground"
    android:fitsSystemWindows="true"
    tools:context=".AdminUploadActivity">

    <!-- Top App Bar -->
    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/topAppBar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="@color/primary"
        android:elevation="4dp"
        app:title="Post Announcement"
        app:titleCentered="true"
        app:titleTextColor="@android:color/white"
        app:navigationIcon="@drawable/ic_arrow_back"
        app:navigationIconTint="@android:color/white" />

    <!-- Scrollable Form Container -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:paddingHorizontal="@dimen/screen_margin_horizontal"
        android:paddingTop="16dp"
        android:paddingBottom="32dp">

        <LinearLayout
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <!-- Form Card -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="24dp"
                app:cardCornerRadius="@dimen/radius_lg"
                app:cardElevation="2dp"
                app:strokeWidth="1dp"
                app:strokeColor="@color/border_subtle"
                app:cardBackgroundColor="@color/colorSurface">

                <LinearLayout
                    android:orientation="vertical"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="20dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="BROADCAST DISPATCH"
                        android:textColor="@color/primary"
                        android:textSize="10sp"
                        android:textStyle="bold"
                        android:letterSpacing="0.08"
                        android:background="@drawable/bg_badge_teal"
                        android:paddingHorizontal="10dp"
                        android:paddingVertical="3dp"
                        android:layout_marginBottom="8dp" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Draft Community Notice"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        android:textColor="@color/text_primary" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="All fields will be published immediately to users' Updates feed."
                        android:textSize="12sp"
                        android:textColor="@color/text_secondary"
                        android:layout_marginTop="2dp"
                        android:layout_marginBottom="20dp" />

                    <!-- Title Field -->
                    <TextView
                        android:text="Announcement Title"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        android:textColor="@color/text_primary"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="6dp" />

                    <EditText
                        android:id="@+id/titleEditText"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:hint="e.g., Flood Advisory: High Tide Alert"
                        android:textColor="@color/text_primary"
                        android:textColorHint="@color/text_tertiary"
                        android:textSize="14sp"
                        android:paddingHorizontal="14dp"
                        android:background="@drawable/bg_edittext_selector"
                        android:layout_marginBottom="16dp"
                        android:inputType="textCapSentences"
                        android:maxLines="1" />

                    <!-- Category / Type Field -->
                    <TextView
                        android:text="Category / Alert Type"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        android:textColor="@color/text_primary"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="6dp" />

                    <EditText
                        android:id="@+id/typeEditText"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:hint="e.g., Weather Alert, Advisory, Evacuation"
                        android:textColor="@color/text_primary"
                        android:textColorHint="@color/text_tertiary"
                        android:textSize="14sp"
                        android:paddingHorizontal="14dp"
                        android:background="@drawable/bg_edittext_selector"
                        android:layout_marginBottom="16dp"
                        android:inputType="textCapWords"
                        android:maxLines="1" />

                    <!-- Author Field -->
                    <TextView
                        android:text="Author / Issuing Agency"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        android:textColor="@color/text_primary"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="6dp" />

                    <EditText
                        android:id="@+id/authorEditText"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:hint="e.g., City Disaster Risk Reduction Office"
                        android:textColor="@color/text_primary"
                        android:textColorHint="@color/text_tertiary"
                        android:textSize="14sp"
                        android:paddingHorizontal="14dp"
                        android:background="@drawable/bg_edittext_selector"
                        android:layout_marginBottom="16dp"
                        android:inputType="textCapWords"
                        android:maxLines="1" />

                    <!-- Content Field -->
                    <TextView
                        android:text="Announcement Content"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        android:textColor="@color/text_primary"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="6dp" />

                    <EditText
                        android:id="@+id/contentEditText"
                        android:layout_width="match_parent"
                        android:layout_height="140dp"
                        android:hint="Provide detailed safety instructions, contact info, affected barangays, and key guidelines..."
                        android:textColor="@color/text_primary"
                        android:textColorHint="@color/text_tertiary"
                        android:textSize="14sp"
                        android:gravity="top|start"
                        android:padding="14dp"
                        android:background="@drawable/bg_edittext_selector"
                        android:layout_marginBottom="24dp"
                        android:inputType="textMultiLine" />

                    <!-- Upload Action Button -->
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/uploadButton"
                        android:layout_width="match_parent"
                        android:layout_height="52dp"
                        android:backgroundTint="@color/primary"
                        android:text="Publish Announcement"
                        android:textAllCaps="false"
                        android:textSize="15sp"
                        android:textStyle="bold"
                        android:textColor="@android:color/white"
                        app:cornerRadius="@dimen/radius_md"
                        android:elevation="2dp" />

                    <!-- Upload Progress -->
                    <ProgressBar
                        android:id="@+id/uploadProgress"
                        android:layout_width="36dp"
                        android:layout_height="36dp"
                        android:layout_gravity="center"
                        android:visibility="gone"
                        android:indeterminateTint="@color/primary"
                        android:layout_marginTop="16dp" />

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>
    </ScrollView>

</LinearLayout>
