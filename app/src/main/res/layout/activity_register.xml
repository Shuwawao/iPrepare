<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/colorBackground"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="24dp"
        android:paddingTop="36dp"
        android:paddingBottom="32dp"
        android:gravity="center_horizontal">

        <!-- App Logo & Branding -->
        <ImageView
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:src="@drawable/iprepare_logo"
            android:scaleType="fitCenter"
            android:layout_marginBottom="12dp"
            android:contentDescription="@string/app_name" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Create Account"
            android:textSize="26sp"
            android:textStyle="bold"
            android:textColor="@color/text_primary"
            android:layout_marginBottom="6dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Stay safe and track disaster preparedness across the Philippines"
            android:textSize="14sp"
            android:textColor="@color/text_secondary"
            android:gravity="center"
            android:layout_marginBottom="28dp" />

        <!-- Form Card Container -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_card_modern"
            android:padding="24dp"
            android:layout_marginBottom="24dp">

            <!-- Name Input -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Full Name"
                android:textSize="13sp"
                android:textStyle="bold"
                android:textColor="@color/text_secondary"
                android:layout_marginBottom="8dp" />

            <EditText
                android:id="@+id/regName"
                android:layout_width="match_parent"
                android:layout_height="@dimen/input_field_height"
                android:background="@drawable/bg_edittext_selector"
                android:hint="Juan Dela Cruz"
                android:textColor="@color/text_primary"
                android:textColorHint="@color/text_hint"
                android:paddingHorizontal="16dp"
                android:inputType="textPersonName"
                android:textSize="15sp"
                android:layout_marginBottom="16dp" />

            <!-- Email Input -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Email Address"
                android:textSize="13sp"
                android:textStyle="bold"
                android:textColor="@color/text_secondary"
                android:layout_marginBottom="8dp" />

            <EditText
                android:id="@+id/regEmail"
                android:layout_width="match_parent"
                android:layout_height="@dimen/input_field_height"
                android:background="@drawable/bg_edittext_selector"
                android:hint="juan@example.com"
                android:textColor="@color/text_primary"
                android:textColorHint="@color/text_hint"
                android:paddingHorizontal="16dp"
                android:inputType="textEmailAddress"
                android:textSize="15sp"
                android:layout_marginBottom="16dp" />

            <!-- Password Input -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Password"
                android:textSize="13sp"
                android:textStyle="bold"
                android:textColor="@color/text_secondary"
                android:layout_marginBottom="8dp" />

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="@dimen/input_field_height"
                android:background="@drawable/bg_edittext_selector"
                android:layout_marginBottom="16dp">

                <EditText
                    android:id="@+id/regPassword"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@android:color/transparent"
                    android:hint="At least 6 characters"
                    android:textColor="@color/text_primary"
                    android:textColorHint="@color/text_hint"
                    android:inputType="textPassword"
                    android:paddingStart="16dp"
                    android:paddingEnd="48dp"
                    android:textSize="15sp" />

                <ImageView
                    android:id="@+id/toggleRegPasswordVisibility"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_gravity="end|center_vertical"
                    android:layout_marginEnd="14dp"
                    android:src="@drawable/ic_eye_closed"
                    app:tint="@color/text_tertiary"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="Toggle password visibility" />
            </FrameLayout>

            <!-- Confirm Password Input -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Confirm Password"
                android:textSize="13sp"
                android:textStyle="bold"
                android:textColor="@color/text_secondary"
                android:layout_marginBottom="8dp" />

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="@dimen/input_field_height"
                android:background="@drawable/bg_edittext_selector"
                android:layout_marginBottom="24dp">

                <EditText
                    android:id="@+id/regConfirmPassword"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@android:color/transparent"
                    android:hint="Re-type password"
                    android:textColor="@color/text_primary"
                    android:textColorHint="@color/text_hint"
                    android:inputType="textPassword"
                    android:paddingStart="16dp"
                    android:paddingEnd="48dp"
                    android:textSize="15sp" />

                <ImageView
                    android:id="@+id/toggleConfirmPasswordVisibility"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_gravity="end|center_vertical"
                    android:layout_marginEnd="14dp"
                    android:src="@drawable/ic_eye_closed"
                    app:tint="@color/text_tertiary"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="Toggle confirm password visibility" />
            </FrameLayout>

            <!-- Register Progress -->
            <ProgressBar
                android:id="@+id/regProgress"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_gravity="center"
                android:indeterminateTint="@color/colorPrimary"
                android:visibility="gone"
                android:layout_marginBottom="16dp" />

            <!-- Register Button -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/registerNowButton"
                style="@style/AppButton.Primary"
                android:text="Create Account"
                android:layout_marginBottom="12dp" />

            <!-- Back to Login Button -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/backToLogin"
                style="@style/AppButton.Outlined"
                android:text="Already have an account? Sign In" />

        </LinearLayout>

    </LinearLayout>
</ScrollView>
